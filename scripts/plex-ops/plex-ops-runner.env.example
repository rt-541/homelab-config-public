# plex-ops runner environment file - EXAMPLE
#
# Install to /etc/plex-ops/runner.env, owned root:root, mode 0600:
#   sudo install -D -o root -g root -m 0600 plex-ops-runner.env.example /etc/plex-ops/runner.env
#   sudoedit /etc/plex-ops/runner.env   # then fill in real values
#
# The runner reads this file directly (sudo -n cat fallback) and systemd
# also loads it via EnvironmentFile= in plex-ops-runner.service.

# REQUIRED: the single bearer token every runner call must present.
# Generate: openssl rand -hex 32
# The runner REFUSES to start on this placeholder or any token shorter
# than 32 characters.
PLEXOPS_TOKEN=CHANGE_ME_openssl_rand_hex_32

# OPTIONAL: qBittorrent WebUI creds. Enables the qbit ownership check in
# the delete-download action; without them the check is skipped.
#QBIT_USER=admin
#QBIT_PASS=change-me

# OPTIONAL: Plex token (reserved for agent-side PMS checks; unused by the
# runner itself in v1).
#PLEX_TOKEN=change-me

# OPTIONAL: runner overrides (defaults shown). Setting BIND to the host's
# LAN address (nemesis: 192.168.1.214) is the simplest LAN-only restriction
# since firewalld is not running on nemesis - see README step 3.
#PORT=8377
#BIND=0.0.0.0
#RUNNER_ENV=/etc/plex-ops/runner.env
