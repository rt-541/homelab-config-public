# ~/.config/llm-jobs/jobs.env on devastator (mode 600). Loaded by the user unit.
LLMJOBS_DB=/home/aschneider/.local/share/llm-jobs/jobs.db
LLMJOBS_BIND=0.0.0.0
LLMJOBS_PORT=8378
LLMJOBS_NCL=/docker/nanoclaw/bin/ncl
LLMJOBS_PUBLIC_URL=https://jobs.rt-541.io
LLMJOBS_RETENTION_DAYS=30
# Tier -> NanoClaw group folder. Timeouts are per job, seconds. Optional
# daily_jobs / daily_tokens cap the whole tier per UTC day across all keys.
LLMJOBS_TIERS='{"local":{"group":"jobs-local","model":"qwen3-14b (vLLM on the B70 via the NanoClaw proxy)","timeout_s":1200,"speed":"fast","cost":"free","notes":"Default. Private, LAN-hosted, about 16k output tokens per job."},"claude":{"group":"jobs-claude","model":"claude-sonnet-5 (Anthropic via the NanoClaw OneCLI vault)","timeout_s":1200,"speed":"fast","cost":"metered","daily_jobs":200,"daily_tokens":2000000,"notes":"Claude-quality output. Metered: per-key daily caps plus a tier-wide daily cap shared by all keys."}}'
