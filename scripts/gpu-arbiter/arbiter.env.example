# ~/.config/gpu-arbiter/arbiter.env on devastator. `systemctl --user restart gpu-arbiter` after editing.
ARBITER_ENABLED=true
# seconds vLLM must be quiet (no running, waiting or newly finished request) before a swap
ARBITER_IDLE_S=60
# longest the card stays lent to photo jobs in one go
ARBITER_MAX_HOLD_S=900
# empty = any time; or a local window like 02:00-05:00
ARBITER_WINDOW=
# GB ComfyUI leaves free for Plex / the media-transcoder while it holds the card
ARBITER_COMFY_RESERVE_GB=2
