---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { versioned } from '../../lib/versioned';

// Detail page for the Backyard card. English-only by design: no data-i18n keys.
// The full drawing set is a standalone page under /plans/backyard/, generated by cad/sheets/backyard/mk.py.

const planHref = '/plans/backyard/';
const pdfHref = versioned('/plans/backyard/backyard.pdf');
const modelHref = '/plans/backyard/model/';
const stepHref = '/plans/backyard/model/backyard.step';
const fusionHref = '/plans/backyard/model/backyard-fusion-script.zip';
const glbHref = '/plans/backyard/model/backyard-summer.glb';

const sheets: { num: string; title: string; body: string; anchor: string }[] = [
  { num: '01', title: 'Design basis', anchor: 's1', body: 'What was decided and why: the deck at the slider, the 16 ft stone patio with its fire apron and ring, the raised herb bed, the AC screen, the walkway, the tree row, what revision A assumes from the drone photos and what to measure for revision B.' },
  { num: '02', title: 'Site plan and section', anchor: 's2', body: 'The whole yard in plan, a true-scale north-south section down the slope, the 3D model and the clearance checks.' },
  { num: '03', title: 'Deck', anchor: 's3', body: 'Framing plan, north elevation, typical section and the one stair: the angled bay, the cut corners, the griddle and smoker, two three-ply beams on piers 42 in deep, 2x10 joists at 12 in, no ledger on the brick veneer. Plus the scope for the deck bid.' },
  { num: '04', title: 'Patio, fire ring, herbs and AC screen', anchor: 's4', body: 'The 16 ft flagstone square with the sofa set, a round apron and stone ring on its corner wrapped by a stone seat wall, the ring, seat wall and herb bed sections, the lattice and mass-loaded vinyl screen around the AC, and the base build-up.' },
  { num: '05', title: 'Evergreens and drain', anchor: 's5', body: 'Five American Pillar in a row on the slider line, and the French drain profile and trench along the east fence into the existing corner drain.' },
  { num: '06', title: 'Quantities', anchor: 's6', body: 'Every quantity a bid should match: boards, guard, posts, stone, base, ring and bed stone, the AC screen and the drain.' },
  { num: '07', title: 'Shopping list and budget', anchor: 's7', body: 'Owner purchases from checked listings, and contractor allowances from published cost guides times the drawing quantities.' },
  { num: '08', title: 'Schedule and permits', anchor: 's8', body: "MISS DIG, the deck permit and five contractor visits in order, then the owner's herb bed." },
  { num: '09', title: 'Care guide', anchor: 's9', body: 'The fire ring, the trees, deck and stone upkeep, herbs and the drain.' },
];
---
<BaseLayout title="backyard &middot; rt-541.io" description="Backyard: drawing set for a freestanding composite deck at the back slider, a flagstone patio with a stone fire ring, a raised herb bed, an AC screen, a stone walkway, a row of American Pillar arborvitae and a French drain.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-8">
    <p class="font-mono text-[10px] tracking-eyebrow uppercase text-chrome opacity-85 mb-5 pb-3 border-b border-chrome/20">
      <a href="/projects" class="no-underline hover:underline">projects</a> / backyard
    </p>
    <h1 class="font-serif text-[34px] leading-[1.1] tracking-display text-chrome mb-3">Backyard</h1>
    <p class="text-[15px] text-ice leading-[1.65] max-w-[58ch]">
      The back yard of a brick ranch, laid out from drone photos: a new composite deck at the back slider, a 16 ft buff
      flagstone patio off its side with a round fire apron and stone ring, a raised herb bed, a quiet screen around
      the AC, a stone walkway around the deck, a row of American Pillar arborvitae along the back fence and a French drain
      along the side that floods. Most of it is contracted, so the drawing set is also the bid package.
    </p>
    <ul class="flex flex-wrap gap-4 mt-5 list-none p-0 font-mono text-[11px] tracking-meta uppercase">
      <li><a href={planHref} class="text-chrome no-underline hover:underline">open the drawing set &rarr;</a></li>
      <li><a href={pdfHref} class="text-chrome no-underline hover:underline">download the PDF &rarr;</a></li>
      <li><a href={modelHref} class="text-chrome no-underline hover:underline">3d model &rarr;</a></li>
    </ul>
  </section>

  <section class="max-w-3xl mx-auto px-6 pt-6">
    <p class="font-mono text-[10px] tracking-eyebrow uppercase text-chrome opacity-70 mb-4">// 3d model</p>
    <figure class="m-0">
      <img src={versioned("/plans/backyard/model/photo-north.png")} alt="Photo-style view of the backyard from the north" loading="lazy" class="w-full h-auto rounded border border-chrome/20" />
      <figcaption class="font-mono text-[11px] tracking-meta text-subtle mt-2">From the north: the plan's model rendered in Blender, then turned into a photograph by FLUX.1 Kontext on the homelab GPU. <a href="/writing/backyard-from-drone-photos">How it was made &rarr;</a></figcaption>
    </figure>
    <figure class="m-0 mt-6">
      <img src={versioned("/plans/backyard/model/render-hero.png")} alt="Render of the deck, patio and fire ring from the northwest" loading="lazy" class="w-full h-auto rounded border border-chrome/20" />
      <figcaption class="font-mono text-[11px] tracking-meta text-subtle mt-2">From the northwest: the deck at the slider with its walkway, the stone patio and fire ring off its west side, the raised herb bed and the AC screen along the house.</figcaption>
    </figure>
    <figure class="m-0 mt-6">
      <img src={versioned("/plans/backyard/model/render-patio.png")} alt="Render of the stone patio with the fire ring, the herb bed and the deck" loading="lazy" class="w-full h-auto rounded border border-chrome/20" />
      <figcaption class="font-mono text-[11px] tracking-meta text-subtle mt-2">The patio: buff flagstone, the round apron and stone fire ring with six chairs on the patio's corner, the raised herb bed and the AC screen along the house.</figcaption>
    </figure>
    <div class="prose-content text-[14px] mt-4">
      <p>
        The model and the drawings come from the same Python module (<code>cad/plans/backyard.py</code>): the grade is a
        plane falling to the north and east, and every stair, clearance and quantity is computed from it. Twenty-nine
        checks run on every export: stair risers, joist spans and cantilevers, post spacing, the fire ring's
        position and its chairs fitting the apron, the herb bed standing off the brick, the AC screen's clearances, the tree gaps and the drain's fall.
      </p>
    </div>
    <ul class="flex flex-wrap gap-4 mt-3 list-none p-0 font-mono text-[11px] tracking-meta uppercase">
      <li><a href={modelHref} class="text-chrome no-underline hover:underline">interactive viewer &rarr;</a></li>
      <li><a href={stepHref} class="text-chrome no-underline hover:underline">step file &rarr;</a></li>
      <li><a href={fusionHref} class="text-chrome no-underline hover:underline">fusion 360 script (zip) &rarr;</a></li>
      <li><a href={glbHref} class="text-chrome no-underline hover:underline">glb &rarr;</a></li>
    </ul>
  </section>

  <section class="max-w-3xl mx-auto px-6 pt-6">
    <p class="font-mono text-[10px] tracking-eyebrow uppercase text-chrome opacity-70 mb-4">// by the numbers</p>
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 m-0">
      <div class="border-l border-chrome/20 pl-3">
        <dt class="font-mono text-[10px] tracking-meta uppercase text-subtle">deck</dt>
        <dd class="m-0 text-[18px] font-serif text-chrome">25 x 20 ft composite</dd>
      </div>
      <div class="border-l border-chrome/20 pl-3">
        <dt class="font-mono text-[10px] tracking-meta uppercase text-subtle">patio</dt>
        <dd class="m-0 text-[18px] font-serif text-chrome">16 x 16 ft flagstone</dd>
      </div>
      <div class="border-l border-chrome/20 pl-3">
        <dt class="font-mono text-[10px] tracking-meta uppercase text-subtle">fire</dt>
        <dd class="m-0 text-[18px] font-serif text-chrome">52 in stone ring</dd>
      </div>
      <div class="border-l border-chrome/20 pl-3">
        <dt class="font-mono text-[10px] tracking-meta uppercase text-subtle">rough total</dt>
        <dd class="m-0 text-[18px] font-serif text-chrome">$26k to $55k</dd>
      </div>
    </dl>
  </section>

  <section class="max-w-3xl mx-auto px-6 pt-12">
    <p class="font-mono text-[10px] tracking-eyebrow uppercase text-chrome opacity-70 mb-2">// what was decided</p>
    <div class="prose-content text-[14px]">
      <p>
        The deck stands at the sliding door in the bay, with its outer corners cut at 45 degrees and a vented composite skirt, the Blackstone and the smoker along its east rail, and one stair down its west side to the patio. It stands on its own. The house is brick veneer, which cannot carry a ledger, so two three-ply beams on
        piers 42 in deep hold it, with the joists cantilevered toward the wall and notched around the chimney and the bay.
        It runs from the chimney to near the east corner, with the slider its only door. Shade is two cantilever umbrellas bolted to blocking in the frame.
      </p>
      <p>
        The stone is one buff flagstone throughout: a 16 ft square patio off the deck's west side, a walkway around the
        deck's other two sides, and a ring of wall stone on a round apron centred on the patio's northwest corner for the fire, wrapped on its north half by an 18 in stone seat wall. The outdoor sofa set lives on the patio.
        The same wall stone makes the raised herb bed, which stands off the brick so no soil touches the veneer, and
        the AC hides behind vinyl lattice over mass-loaded vinyl that damps its hum toward the patio and needs no upkeep, left open to the west and on top so the unit still breathes. The trees are five
        American Pillar arborvitae, which grow tall but stay about 4 ft wide, in one row straight out from the slider.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pt-12 pb-20">
    <p class="font-mono text-[10px] tracking-eyebrow uppercase text-chrome opacity-70 mb-2">// the drawing set</p>
    <ul class="list-none p-0 m-0">
      {sheets.map(s => (
        <li class="py-5 border-b border-chrome/10 grid grid-cols-[5rem,1fr] gap-6">
          <span class="font-mono text-[11px] tracking-meta text-subtle pt-1">sheet {s.num}</span>
          <div>
            <h2 class="font-serif text-[18px] text-chrome leading-tight m-0">
              <a href={`${planHref}#${s.anchor}`} class="no-underline hover:underline">{s.title}</a>
            </h2>
            <p class="text-[14px] text-ice leading-[1.65] mt-2 mb-0">{s.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
