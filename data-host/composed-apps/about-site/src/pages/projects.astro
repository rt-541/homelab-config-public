---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order);
const groups: { kind: 'virtual' | 'physical'; items: typeof all }[] = [
  { kind: 'virtual', items: all.filter(p => p.data.kind === 'virtual') },
  { kind: 'physical', items: all.filter(p => p.data.kind === 'physical') },
].filter(g => g.items.length > 0);
---
<BaseLayout title="projects &middot; rt-541.io" description="Things I've built.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-8">
    <p class="font-mono text-[10px] tracking-eyebrow uppercase text-chrome opacity-85 mb-5 pb-3 border-b border-chrome/20" data-i18n="projects.eyebrow">
      projects
    </p>
    <h1 class="font-serif text-[34px] leading-[1.1] tracking-display text-chrome mb-2" data-i18n="projects.h1">Things I've built</h1>
    <p class="text-[14px] text-subtle" data-i18n="projects.subtitle">A grab-bag of work and side projects. Click through for details.</p>
  </section>

  <div class="max-w-3xl mx-auto px-6 pb-20">
    {all.length === 0 ? (
      <p class="text-subtle text-[14px]">No projects yet.</p>
    ) : (
      groups.map(g => (
        <section id={g.kind} class="mb-12">
          <header class="mb-2 pb-3 border-b border-chrome/20">
            <h2 class="font-serif text-[24px] leading-tight text-chrome m-0" data-i18n={`projects.${g.kind}.h2`}>{g.kind === 'virtual' ? 'Virtual' : 'Physical'}</h2>
            <p class="text-[13px] text-subtle mt-1 mb-0" data-i18n={`projects.${g.kind}.sub`}>{g.kind === 'virtual' ? 'Software, infrastructure and the homelab.' : 'Things built from plywood, steel and wire, with drawing sets.'}</p>
          </header>
          {g.items.map(p => <ProjectCard entry={p} />)}
        </section>
      ))
    )}
  </div>
</BaseLayout>
