# Secrets / environment files
.env
**/.env
!**/.env.example
# Backup copies of env files (e.g. .env.bak-123456) — full secret sets, never commit
**/.env.bak*
**/*.env.bak*

minecraft_data

# Git worktrees
.worktrees/

# Superpowers brainstorming companion
.superpowers/

# Python bytecode
__pycache__/
**/__pycache__/
*.pyc
*.pyo
# Game-server env files (contain webhooks/passwords); keep on host only
override.env
default.env

# --- runtime data / state (host-only, never commit) ---
data-host/composed-apps/mealie/postgres/
data-host/composed-apps/nemesis-bot/state/
data-host/composed-apps/homepage/config/logs/

# Per-app env files with secrets (repo policy: no .env committed)
**/.env.web

# Local Claude Code agent config
.claude/
**/.claude/
