# Copy to .env in this directory and fill in. .env is gitignored repo-wide.
#
# The real API keys live on this host in the arr config files:
#   sudo grep -o '<ApiKey>[^<]*</ApiKey>' /docker/sonarr/config.xml
#   sudo grep -o '<ApiKey>[^<]*</ApiKey>' /docker/radarr/config.xml
SONARR_API_KEY=
RADARR_API_KEY=

# Optional: override the sync cadence (cron syntax, container-local time).
# Default when unset: daily at 06:00 America/Detroit.
#CRON_SCHEDULE=0 6 * * *
