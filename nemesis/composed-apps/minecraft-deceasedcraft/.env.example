# Copy to .env (gitignored) and fill in real values. All secrets stay local.
# Standard itzg/minecraft-server env vars. See https://docker-minecraft-server.readthedocs.io/
EULA=TRUE
MEMORY=
# RCON for remote admin (used by the management/automation tooling)
ENABLE_RCON=true
RCON_PASSWORD=
# CurseForge modpack installs require an API key (TYPE=CURSEFORGE / AUTO_CURSEFORGE)
CF_API_KEY=
