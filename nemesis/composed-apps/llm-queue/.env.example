# Copy to .env (gitignored) and fill in real values. All secrets stay local.
# Signs the web-UI session cookie (any long random string). Still required.
SESSION_SECRET=change-this-to-a-long-random-string
# Legacy Phase A web password. No longer the login (the login is now a LiteLLM
# virtual key validated against the gateway), but auth.py still requires it to be
# set (fail-closed). Any non-empty value is fine.
APP_PASSWORD=unused-in-phase-b

# --- Gateway + per-job key (Phase B) ---
# LiteLLM gateway the queue validates caller keys against and routes jobs to
# (both containers share the proxy Docker network, so the name resolves).
GATEWAY_URL=http://llm-gateway:4000
# /key/info probe auth: "self" (key validates itself; verified working) or "master".
GATEWAY_KEYINFO_AUTH=self
# Only needed if GATEWAY_KEYINFO_AUTH=master.
GATEWAY_MASTER_KEY=
# Fernet key encrypting each job's caller key at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOB_KEY_SECRET=REPLACE_ME

# --- Backend registry metadata (selection/tier labels only; runtime calls go to the gateway) ---
# fast -> B70 vLLM (GPU, OpenAI-compatible). Different host, reachable on LAN.
FAST_BACKEND_URL=http://192.168.1.216:8000/v1
FAST_MODEL=qwen2.5-7b-instruct
# background -> nemesis Ollama (CPU). Same host: reach it via the docker0 gateway
# (host.docker.internal) since Ollama binds 172.17.0.1:11434, not the LAN IP.
BACKGROUND_BACKEND_URL=http://host.docker.internal:11434/v1
BACKGROUND_MODEL=qwen2.5:7b
# reasoning -> nemesis Ollama (CPU), deepseek-r1 CoT model.
REASONING_BACKEND_URL=http://host.docker.internal:11434/v1
REASONING_MODEL=deepseek-r1:7b

# --- Selection ---
# When true, ambiguous jobs are routed by the background model using
# prompts/model-selection.md. Default false (rules table only).
SELECTION_LLM_ENABLED=false

# --- Misc ---
RETENTION_DAYS=30
DB_PATH=/data/queue.db
WEBHOOK_URL=
